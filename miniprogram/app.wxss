/* app.wxss — 全局样式：蓝白教育风 */
page { background: #F3F4F6; font-size: 28rpx; color: #111827; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }
.btn-primary { background: #1A56DB; color: #fff; border-radius: 12rpx; padding: 20rpx; text-align: center; }
.btn-ghost { border: 2rpx solid #1A56DB; color: #1A56DB; border-radius: 12rpx; padding: 18rpx; text-align: center; }
.tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 20rpx; background: #EFF6FF; color: #1A56DB; margin-right: 8rpx; }
.tag.up { background: #FEF2F2; color: #DC2626; }
.tag.down { background: #ECFDF5; color: #059669; }
.muted { color: #6B7280; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; }
