{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "score_lines",
  "description": "院校/专业复试线，一条 = (schoolId, majorCode, studyType, year)",
  "type": "object",
  "required": ["schoolId", "majorName", "studyType", "year", "total", "sourceUrl"],
  "properties": {
    "schoolId": { "type": "string" },
    "majorCode": { "type": ["string", "null"] },
    "majorName": { "type": "string" },
    "studyType": { "type": "string", "enum": ["学硕", "专硕"] },
    "year": { "type": "integer", "minimum": 2020 },
    "total": { "type": "number" },
    "politics": { "type": ["number", "null"], "description": "政治（管理类联考时为管综分）" },
    "english": { "type": ["number", "null"], "description": "英语" },
    "mathOrPro": { "type": ["number", "null"], "description": "业务课一/数学" },
    "pro2": { "type": ["number", "null"], "description": "业务课二（无则null）" },
    "minAdmit": { "type": ["number", "null"], "description": "录取最低分" },
    "avgAdmit": { "type": ["number", "null"] },
    "maxAdmit": { "type": ["number", "null"], "description": "录取最高分" },
    "planCount": { "type": ["number", "null"], "description": "招生计划数" },
    "retestCount": { "type": ["number", "null"], "description": "进入复试人数" },
    "admitCount": { "type": ["number", "null"], "description": "实际录取人数" },
    "statSource": { "type": "string", "description": "录取统计来源（拟录取名单公示链接），与 sourceUrl（分数线来源）区分" },
    "admitBands": { "type": ["string", "null"], "description": "录取分数段分布聚合，如 400+:5人;390-399:12人（禁个人名单）" },
    "subjectAvg": { "type": ["string", "null"], "description": "录取者各科平均分聚合，如 政68/英75/数120/专业125" },
    "reason": { "type": "string", "description": "涨跌原因，无公开说明则留空" },
    "sourceUrl": { "type": "string", "description": "官网来源链接，必填" },
    "verified": { "type": "boolean", "description": "是否经官网核验；false=示例数据，前端须标示例" }
  }
}
